# Settings for the offline build and install (see docs/OFFLINE-REPLACE-INSTALL.md).
# Copy this file to ".env" in the same directory: cp offline.env.example .env
#
# The name that prefixes the containers, the network and the volumes. Pick one that is NOT the name of the
# installation you are replacing, so that its volumes stay untouched.
COMPOSE_PROJECT_NAME=netbox-plugins
# The port NetBox is published on on the host.
NETBOX_HTTP_PORT=8000
# The compose files to use: the base, the offline overlay (no source trees mounted, plugins baked into the
# image) and the PostGIS overlay. With COMPOSE_FILE set, docker-compose.override.yml is NOT picked up.
COMPOSE_FILE=docker-compose.yml:docker-compose.offline.yml:extensions/postgis-pathways/docker-compose.postgis.yml
